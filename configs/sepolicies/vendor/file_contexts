/dev/elliptic1  u:object_r:sensors_device:s0

# MTK VPU daemon: the MTK base regex only matches "v3avpud" / "v3avpud.mtNNNN",
# not our "-64b" suffixed binary, so it fell back to vendor_file and init
# refused to exec it (no domain transition -> codec capability init never ran).
# Stock vendor_file_contexts:711 labels these vpud_native_exec.
/vendor/bin/v3avpud-64b(\.mt[0-9]+)?             u:object_r:vpud_native_exec:s0
/vendor/bin/mt[0-9]+/v3avpud-64b(\.mt[0-9]+)?    u:object_r:vpud_native_exec:s0
