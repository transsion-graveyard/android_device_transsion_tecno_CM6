# Lineage health HAL owns the stock MTK bypass-charging switch.
allow hal_lineage_health_default sysfs:dir search;
allow hal_lineage_health_default sysfs_batteryinfo:dir search;
allow hal_lineage_health_default sysfs_aichg_file:file rw_file_perms;
allow hal_lineage_health_default sysfs_aichg_file:dir search;
