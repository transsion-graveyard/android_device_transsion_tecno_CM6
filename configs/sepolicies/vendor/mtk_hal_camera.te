binder_call(mtk_hal_camera, trancamserver)

# The camera EIS thread probes ro.zygote.disable_gl_preload through the
# property area. Stock policy does not grant this vendor-domain read; grant it
# explicitly because the HAL queries it during EIS setup.
get_prop(mtk_hal_camera, zygote_config_prop)

allow mtk_hal_camera cml421_ois_device:chr_file rw_file_perms;
allow mtk_hal_camera cwvi5300_device:chr_file rw_file_perms;
allow mtk_hal_camera sysfs_dt_firmware_android:dir search;
allow mtk_hal_camera sysfs_dt_firmware_android:file r_file_perms;
allow mtk_hal_camera sysfs_sub_torch_file:file rw_file_perms;
allow mtk_hal_camera sysfs_torch_file:file rw_file_perms;
allow mtk_hal_camera sysfs_wide_torch_file:file rw_file_perms;
allow mtk_hal_camera sysfs_tran_cam_file:file rw_file_perms;
allow mtk_hal_camera sysfs_sensor:dir r_dir_perms;
allow mtk_hal_camera sysfs_sensor:file r_file_perms;
allow mtk_hal_camera sysfs_therm:dir search;
allow mtk_hal_camera sysfs_therm:file r_file_perms;
# Stock vendor_sepolicy.cil parity: mtk_hal_camera gets dir {read write open add_name
# search} and file {read write create getattr open}. The missing 'getattr' caused
# AVC denials when the HAL stat()'d /data/vendor/multicam/sat/*.bin.
allow mtk_hal_camera transsion_camera_data_file:dir { read write open add_name search };
allow mtk_hal_camera transsion_camera_data_file:file { read write create getattr open };
allow mtk_hal_camera vendor_arcsoft_data_file:dir { read write open add_name search };
allow mtk_hal_camera vendor_arcsoft_data_file:file { read write create getattr open };
allow mtk_hal_camera vendor_megvii_data_file:dir { read write open add_name search };
allow mtk_hal_camera vendor_megvii_data_file:file { read write create getattr open };
allow mtk_hal_camera vendor_watermark_data_file:dir { read write open add_name search };
allow mtk_hal_camera vendor_watermark_data_file:file { read write create getattr open };
allow mtk_hal_camera property_socket:sock_file write;
allow mtk_hal_camera hal_trancamserver_hwservice:hwservice_manager find;
allow mtk_hal_camera hal_trancamserver_service:service_manager find;
allow mtk_hal_camera fwk_sensor_service:service_manager find;
# optional Transsion perf-hint service (blob not shipped) - silence lookup noise
dontaudit mtk_hal_camera default_android_service:service_manager find;

get_prop(mtk_hal_camera, vendor_camera_prop)

# IBGService is registered by camerahalserver on stock (hal_mtk_bgs_server attr)
allow mtk_hal_camera mtk_hal_bgs_service:service_manager { add find };
get_prop(mtk_hal_camera, graphics_config_prop)
get_prop(mtk_hal_camera, graphics_config_writable_prop)
get_prop(mtk_hal_camera, exported_default_prop)
set_prop(mtk_hal_camera, vendor_mtk_camera_prop)
set_prop(mtk_hal_camera, vendor_mtk_mediatek_prop)
typeattribute mtk_hal_camera mlstrustedsubject;
dontaudit mtk_hal_camera shell_data_file:dir search;
allow mtk_hal_camera system_data_file:dir { search };
dontaudit mtk_hal_camera unlabeled:filesystem getattr;


# IPostDevice/default intentionally unmapped (service unused); silence lookup noise
dontaudit mtk_hal_camera default_android_service:service_manager add;

# EIS thread probes /data/system/user/<id>; AOSP neverallows vendor HAL
# access to core data dirs - silence only (stock behaves the same)
dontaudit mtk_hal_camera system_userdir_file:dir search;

# MTK streaming algo maps executable memory (TRN STREAM threads)
allow mtk_hal_camera self:process execmem;

# ---------------------------------------------------------------------------
# Stock CM6 camera HAL policy (vendor_sepolicy.cil mtk_hal_camera rules).
# These are required by the Transsion camera stack and its camera HAL.
# ---------------------------------------------------------------------------

# Camera service / cameraserver / app binder path
allow mtk_hal_camera cameraserver:binder { call transfer };
allow mtk_hal_camera cameraserver:fd use;
allow cameraserver mtk_hal_camera:binder { call transfer };
allow cameraserver mtk_hal_camera:fd use;
allow mtk_hal_camera platform_app_all:binder transfer;
allow mtk_hal_camera platform_app_all:fd use;
allow mtk_hal_camera vndservicemanager:binder { call transfer };
allow mtk_hal_camera shell:binder { call transfer };
allow mtk_hal_camera shell:fd use;
allow mtk_hal_camera shell:unix_stream_socket { read write };
allow mtk_hal_camera shell:fifo_file { write lock append map open };

