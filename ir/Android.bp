cc_binary {
    name: "android.hardware.ir-service.cm6",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.ir-service.cm6.rc"],
    vintf_fragments: ["android.hardware.ir-service.cm6.xml"],
    srcs: ["ir_service.cpp"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "android.hardware.ir-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
