    <!-- ===== Screen-off UDFPS unlock =====
         UdfpsController.isScreenOffUnlockEnabled() gates mAodInterruptRunnable.run()
         in onAodInterrupt(): with the screen off (mScreenOn=false) the AOD finger-down
         is otherwise deferred and onFingerDown never runs, so the HBM dim layer is
         never shown. Stock enables the toggle and defaults it on. -->
    <bool name="config_screen_off_udfps_enabled">true</bool>
    <bool name="config_screen_off_udfps_default_on">true</bool>
    <!-- Lift-to-wake (pickup gesture) -->
