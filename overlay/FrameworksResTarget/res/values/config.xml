    <!--
        Device framework config for TECNO CM6 (mt6789), built ground-up from the
        stock framework_res overlays in the firmware dump. Priority order (highest
        first): tr_region (980) > tr_product (970) > FrameworkResOverlayExt (2)
        > FrameworkResOverlay (0). An entry is only ported if the resource exists
        in THIS ROM's framework-res; Transsion-only / renamed resources are listed
        under "Excluded" and are intentionally absent.

        Sources:
          tr_product/overlay/android/CM6_overlay_android.apk  (com.transsion.rro.framework_res.tr_product.cm6)
          tr_region/overlay/android/CM6_overlay_android.apk   (com.transsion.rro.framework_res.tr_region.cm6)
          vendor/overlay/FrameworkResOverlay/FrameworkResOverlay.apk       (com.mediatek.frameworkresoverlay)
          vendor/overlay/FrameworkResOverlayExt/FrameworkResOverlayExt.apk (com.mediatek.FrameworkResOverlayExt)

        Excluded (not present in this framework-res, or app not shipped):
          config_dozeAfterScreenOff            -> this ROM names it config_dozeAfterScreenOffByDefault
          config_hearing_aid_profile_supported -> resource does not exist here
          config_dozeComponent                 -> com.transsion.aod (TranAodApk) is not shipped in this ROM
          irq_device_map, power_profile (MTK)  -> overridden by higher-priority tr_product / use device default
          config_priorityOnlyDndExemptPackages, required_apps_managed_*, supported_locales,
          config_defaultDialer/Sms/Assistant/... -> reference Transsion apps absent from this ROM
    -->

    <!-- ===== LED fix (intentional; device HAS an LED, shipped cm6 led hal from dt) ===== -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <!-- ===== Verify DT2W (transsion FTS gesture wake, matches stock) =====
         Stock: TranTp writes /proc/gesture_function "cc1"; at screen-off the
         adaptive-ts driver enters TRAN_GESTURE_SUSPEND_MODE and reports
         KEY_F26 (linux 198) on double-tap (widget: mtk-tpd.kl maps it to
         WAKEUP). This bool makes PowerManagerService forward the
         Settings.Secure.DOUBLE_TAP_TO_WAKE state to the power HAL
         (Mode::DOUBLE_TAP_TO_WAKE), which fires the powerhint.json
         DOUBLE_TAP_TO_WAKE action that arms the node. -->
    <bool name="config_supportDoubleTapWake">true</bool>

