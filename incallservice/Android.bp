android_app {
    name: "CM6InCallService",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,

    optimize: {
        enabled: false,
    },

    required: [
        "privapp-permissions-cm6incall",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-cm6incall",
    src: "privapp-permissions-cm6incall.xml",
    filename: "privapp-permissions-cm6incall.xml",
    sub_dir: "permissions",
}
