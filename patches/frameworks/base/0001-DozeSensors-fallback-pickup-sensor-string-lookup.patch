From: ashallowperson <245951141+ashallowperson@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:11:38 +0500
Subject: [PATCH] DozeSensors: fall back to string lookup for pickup sensor

---
 .../android/systemui/doze/DozeSensors.java    | 23 ++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/systemui/doze/DozeSensors.java b/packages/SystemUI/src/com/android/systemui/doze/DozeSensors.java
index 3b9c40537..8fe0148cc 100644
--- a/packages/SystemUI/src/com/android/systemui/doze/DozeSensors.java
+++ b/packages/SystemUI/src/com/android/systemui/doze/DozeSensors.java
@@ -195,7 +195,7 @@ public class DozeSensors {
                         false /* touchscreen */
                 ),
                 new TriggerSensor(
-                        mSensorManager.getDefaultSensor(Sensor.TYPE_PICK_UP_GESTURE),
+                        dozePickupSensor(),
                         Settings.Secure.DOZE_PICK_UP_GESTURE,
                         resources.getBoolean(
                                 R.bool.config_dozePickupGestureEnabled) /* settingDef */,
@@ -346,6 +346,27 @@ public class DozeSensors {
         return findSensor(mSensorManager, type, null);
     }

+    /**
+     * Resolves the pickup sensor for the doze pickup trigger.
+     *
+     * <p>AOSP looks up {@link Sensor#TYPE_PICK_UP_GESTURE} (integer type 25) directly. Some devices
+     * (e.g. Transsion/TECNO MT6789) expose their pickup sensor only as a vendor sensor type
+     * (string "android.sensor.pickup", integer 65635) instead, so the default lookup returns null
+     * and lift-to-wake silently never arms. As a fallback, if no type-25 sensor exists we look the
+     * sensor up by its string type so those devices also get lift-to-wake. Devices that expose a
+     * standard type-25 sensor are unaffected (the fallback is never reached).
+     */
+    private Sensor dozePickupSensor() {
+        Sensor pickup = mSensorManager.getDefaultSensor(Sensor.TYPE_PICK_UP_GESTURE);
+        if (pickup == null) {
+            pickup = findSensor(Sensor.STRING_TYPE_PICK_UP_GESTURE);
+        }
+        if (pickup == null) {
+            pickup = findSensor("android.sensor.pickup");
+        }
+        return pickup;
+    }
+
     @NonNull
     private Sensor[] findSensors(@NonNull String[] types) {
         Sensor[] sensorMap = new Sensor[DevicePostureController.SUPPORTED_POSTURES_SIZE];
