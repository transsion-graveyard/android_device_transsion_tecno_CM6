on early-boot
    # Display backlight is exposed as an LED-class device on this platform.
    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/lcd-backlight/max_brightness

on post-fs-data
    chmod 0666 /dev/tran_led

service vendor.light-default /vendor/bin/hw/android.hardware.light-service.cm6
    class hal
    user system
    group system
    shutdown critical
